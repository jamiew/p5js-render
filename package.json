{
  "name": "p5js-render",
  "version": "1.0.0",
  "description": "Headless p5.js sketch to video frame renderer",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "test": "vitest",
    "render": "tsx src/cli.ts",
    "render:url": "tsx src/cli.ts url",
    "render:code": "tsx src/cli.ts code",
    "render:all": "tsx src/cli.ts all",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "p5js",
    "video",
    "render",
    "headless",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.4.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/p5": "^1.7.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}

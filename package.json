{
  "name": "p5js-render",
  "version": "1.0.0",
  "description": "Render p5.js sketches to video offline, deterministically, in headless Chromium",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "p5js-render": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "render": "node src/cli.ts",
    "render:all": "node src/cli.ts --all",
    "media": "node scripts/build-media.ts",
    "site": "node scripts/build-site.ts",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test --run"
  },
  "keywords": [
    "p5js",
    "video",
    "render",
    "headless",
    "typescript"
  ],
  "repository": "github:jamiew/p5js-renderer",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5",
    "p5": "^2.3.3",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
